spring.application.name=api

# Conexión a SQL Server - copia este archivo como application.properties
# y reemplaza los valores reales (ese archivo NO se sube a Git)
spring.datasource.url=jdbc:sqlserver://localhost:1433;databaseName=spotify_wrapped;encrypt=true;trustServerCertificate=true
spring.datasource.username=sa
spring.datasource.password=TU_PASSWORD_AQUI
spring.datasource.driver-class-name=com.microsoft.sqlserver.jdbc.SQLServerDriver

spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.SQLServerDialect

server.port=8080